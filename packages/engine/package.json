{
  "name": "@retiregolden/engine",
  "version": "0.2.0",
  "description": "Pure-TypeScript retirement-planning engine: year-by-year household projection with federal + state taxes, Social Security, RMDs, Roth conversions, withdrawal strategies, Monte Carlo, and an LP optimizer. Deterministic, no DOM, no network.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetireGolden/RetireGolden.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/RetireGolden/RetireGolden/tree/main/packages/engine#readme",
  "bugs": "https://github.com/RetireGolden/RetireGolden/issues",
  "keywords": [
    "retirement",
    "financial-planning",
    "social-security",
    "roth-conversion",
    "monte-carlo",
    "tax"
  ],
  "files": [
    "dist",
    "schema/plan.v1.json",
    "schema/plan.v2.json",
    "schema/plan.v3.json",
    "schema/plan.v4.json",
    "schema/plan.v5.json",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    },
    "./decisions": {
      "types": "./dist/decisions/index.d.ts",
      "default": "./dist/decisions/index.js"
    },
    "./params": {
      "types": "./dist/params/index.d.ts",
      "default": "./dist/params/index.js"
    },
    "./params/state": {
      "types": "./dist/params/state/index.d.ts",
      "default": "./dist/params/state/index.js"
    },
    "./rules": {
      "types": "./dist/rules/index.d.ts",
      "default": "./dist/rules/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema/current": {
      "types": "./dist/schema/current.d.ts",
      "default": "./dist/schema/current.js"
    },
    "./schema/v1": {
      "types": "./dist/schema/plan.v1.generated.d.ts",
      "default": "./dist/schema/plan.v1.generated.js"
    },
    "./schema/v2": {
      "types": "./dist/schema/plan.v2.generated.d.ts",
      "default": "./dist/schema/plan.v2.generated.js"
    },
    "./schema/v3": {
      "types": "./dist/schema/plan.v3.generated.d.ts",
      "default": "./dist/schema/plan.v3.generated.js"
    },
    "./schema/v4": {
      "types": "./dist/schema/plan.v4.generated.d.ts",
      "default": "./dist/schema/plan.v4.generated.js"
    },
    "./schema/v5": {
      "types": "./dist/schema/plan.v5.generated.d.ts",
      "default": "./dist/schema/plan.v5.generated.js"
    },
    "./schema/plan.v1.json": "./schema/plan.v1.json",
    "./schema/plan.v2.json": "./schema/plan.v2.json",
    "./schema/plan.v3.json": "./schema/plan.v3.json",
    "./schema/plan.v4.json": "./schema/plan.v4.json",
    "./schema/plan.v5.json": "./schema/plan.v5.json",
    "./actions/*": null,
    "./actions/annualQcdExecutionPrerequisite": {
      "types": "./dist/actions/annualQcdExecutionPrerequisite.d.ts",
      "default": "./dist/actions/annualQcdExecutionPrerequisite.js"
    },
    "./actions/civilDate": {
      "types": "./dist/actions/civilDate.d.ts",
      "default": "./dist/actions/civilDate.js"
    },
    "./actions/contract": {
      "types": "./dist/actions/contract.d.ts",
      "default": "./dist/actions/contract.js"
    },
    "./actions/execution": {
      "types": "./dist/actions/execution.d.ts",
      "default": "./dist/actions/execution.js"
    },
    "./actions/identity": {
      "types": "./dist/actions/identity.d.ts",
      "default": "./dist/actions/identity.js"
    },
    "./actions/money": {
      "types": "./dist/actions/money.d.ts",
      "default": "./dist/actions/money.js"
    },
    "./actions/planBalanceAdapter": {
      "types": "./dist/actions/planBalanceAdapter.d.ts",
      "default": "./dist/actions/planBalanceAdapter.js"
    },
    "./actions/reasons": {
      "types": "./dist/actions/reasons.d.ts",
      "default": "./dist/actions/reasons.js"
    },
    "./actions/retirementActionCandidateIdentityAllocator": {
      "types": "./dist/actions/retirementActionCandidateIdentityAllocator.d.ts",
      "default": "./dist/actions/retirementActionCandidateIdentityAllocator.js"
    },
    "./actions/retirementActionManualReview": {
      "types": "./dist/actions/retirementActionManualReview.d.ts",
      "default": "./dist/actions/retirementActionManualReview.js"
    },
    "./allocation/*": {
      "types": "./dist/allocation/*.d.ts",
      "default": "./dist/allocation/*.js"
    },
    "./decisions/*": {
      "types": "./dist/decisions/*.d.ts",
      "default": "./dist/decisions/*.js"
    },
    "./insights/*": {
      "types": "./dist/insights/*.d.ts",
      "default": "./dist/insights/*.js"
    },
    "./ladder/*": {
      "types": "./dist/ladder/*.d.ts",
      "default": "./dist/ladder/*.js"
    },
    "./longevity/*": {
      "types": "./dist/longevity/*.d.ts",
      "default": "./dist/longevity/*.js"
    },
    "./model/*": {
      "types": "./dist/model/*.d.ts",
      "default": "./dist/model/*.js"
    },
    "./montecarlo/*": {
      "types": "./dist/montecarlo/*.d.ts",
      "default": "./dist/montecarlo/*.js"
    },
    "./params/*": {
      "types": "./dist/params/*.d.ts",
      "default": "./dist/params/*.js"
    },
    "./projection/internal/*": null,
    "./projection/*": {
      "types": "./dist/projection/*.d.ts",
      "default": "./dist/projection/*.js"
    },
    "./rmd/*": {
      "types": "./dist/rmd/*.d.ts",
      "default": "./dist/rmd/*.js"
    },
    "./scenarios/*": {
      "types": "./dist/scenarios/*.d.ts",
      "default": "./dist/scenarios/*.js"
    },
    "./schema/*": {
      "types": "./dist/schema/*.d.ts",
      "default": "./dist/schema/*.js"
    },
    "./socialSecurity/*": {
      "types": "./dist/socialSecurity/*.d.ts",
      "default": "./dist/socialSecurity/*.js"
    },
    "./spending/*": {
      "types": "./dist/spending/*.d.ts",
      "default": "./dist/spending/*.js"
    },
    "./strategies/*": {
      "types": "./dist/strategies/*.d.ts",
      "default": "./dist/strategies/*.js"
    },
    "./tax/*": {
      "types": "./dist/tax/*.d.ts",
      "default": "./dist/tax/*.js"
    },
    "./testing/*": {
      "types": "./dist/testing/*.d.ts",
      "default": "./dist/testing/*.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "default": "./dist/version.js"
    },
    "./*": null,
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "generate:schema": "pnpm run build && node scripts/generate-schema.mjs",
    "generate:version": "node scripts/generate-version.mjs",
    "equivalence": "node scripts/equivalence.mjs",
    "rules:coverage": "node scripts/rules-coverage.mjs",
    "rules:due": "node scripts/rules-due.mjs",
    "rules:dispatch": "node scripts/rules-dispatch.mjs",
    "verify:quotes": "node scripts/verify-quotes.mjs",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:coverage": "tsc -p tsconfig.json && vitest run --coverage",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "highs": "^1.15.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
