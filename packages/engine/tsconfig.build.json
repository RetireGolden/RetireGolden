{
  /* Build config — `tsc -b tsconfig.build.json` emits dist/, and this is the
     project the root, app, and planner-ui tsconfigs reference. The test
     exclude belongs here rather than in tsconfig.json (see the note there)
     so co-located *.test.ts files never ship in dist. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "stripInternal": true
  },
  "include": ["src"],
  /* symbolLines.ts imports the typescript devDependency; it serves the
     conformance/freshness suites and the coverage publisher
     (rules-coverage.mjs, via rule-tooling-shared.mjs) only, so it stays out
     of dist like the tests do. */
  "exclude": ["src/**/*.test.ts", "src/rules/symbolLines.ts"]
}
