{
  "name": "@retiregolden/planner-ui",
  "version": "0.9.0",
  "description": "The RetireGolden planner React UI: plan picker, planner workspace, results/Monte Carlo/optimizer pages, import wizard, Learning Center, and report export — the full planner tree a host app composes inside its own router. Ships TypeScript source and requires a Vite-class bundler.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RetireGolden/RetireGolden.git",
    "directory": "packages/planner-ui"
  },
  "homepage": "https://github.com/RetireGolden/RetireGolden/tree/main/packages/planner-ui#readme",
  "bugs": "https://github.com/RetireGolden/RetireGolden/issues",
  "keywords": [
    "retirement",
    "financial-planning",
    "react",
    "planner",
    "monte-carlo"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__snapshots__",
    "!src/**/*.fixture.json",
    "!src/testSupport",
    "!src/report/goldens",
    "!src/import/documentBenchmark.ts",
    "!src/import/documentCorpus.ts",
    "!src/import/pdfFixtures.ts",
    "LICENSE",
    "README.md"
  ],
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./plan-format": "./src/data/planFormat.ts",
    "./complete-export": "./src/data/completeExport.ts",
    "./plan-tax-calculator": "./src/planTaxCalculator.ts",
    "./projection": "./src/projection.ts",
    "./import-provenance": "./src/import/provenance.ts",
    "./import-refresh": "./src/import/refresh.ts",
    "./intake-refresh": "./src/import/intakeRefresh.ts",
    "./document-text": "./src/import/documentText.ts",
    "./migration-source": "./src/import/migrationSource.ts",
    "./report-model": "./src/report/reportModel.ts",
    "./scenario-levers": "./src/scenarioLevers.ts",
    "./spending-solve": "./src/spendingSolve.ts",
    "./index.css": "./src/index.css",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "benchmark:documents": "node scripts/document-benchmark.mjs"
  },
  "dependencies": {
    "@retiregolden/engine": "^0.2.0",
    "highs": "^1.14.2",
    "idb": "^8.0.3",
    "recharts": "^3.8.1"
  },
  "peerDependencies": {
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^30.0.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
