# Report goldens are compared byte-for-byte (vitest toMatchFileSnapshot);
# pin them to LF so Windows autocrlf checkouts don't break the comparison.
packages/planner-ui/src/report/goldens/** text eol=lf
# Vitest rewrites inline snapshot files with LF regardless of platform. Under
# autocrlf a CRLF checkout leaves a stale size in the index, so every local test
# run leaves the file "modified" with an empty diff. Pin them to LF to match
# what vitest writes.
*.snap text eol=lf
# The complete-export manifest fixture is byte-exact producer output whose
# SHA-256 is pinned in tests; a CRLF rewrite would change the digest.
packages/planner-ui/src/data/*.fixture.json text eol=lf
packages/engine/schema/plan.v*.json linguist-generated=true
packages/engine/src/schema/plan.v*.generated.ts linguist-generated=true
# High-churn generated operations ledgers; collapse in diffs and skip
# automated review so PR context isn't spent re-reviewing machine output.
DOCS/operations/rule-coverage.json linguist-generated=true
DOCS/operations/rule-coverage/*.json linguist-generated=true
DOCS/operations/quote-fidelity-ledger.json linguist-generated=true
