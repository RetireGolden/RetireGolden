{
  "name": "retiregolden-web",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-budget.mjs && node scripts/check-css-clamp.mjs && node scripts/generate-sitemap.mjs",
    "bundle-budget": "node scripts/check-bundle-budget.mjs --report",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dist": "playwright test -c playwright.dist.config.ts",
    "test:coverage": "vitest run --coverage",
    "cases": "node scripts/cases.mjs",
    "cases:diff": "node scripts/cases.mjs diff",
    "owl-parity": "node scripts/owl-parity.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "@retiregolden/engine": "workspace:^",
    "@retiregolden/planner-ui": "workspace:^",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
