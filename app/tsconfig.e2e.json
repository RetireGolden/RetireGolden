{
  /* The Playwright specs and the two root-level config modules. Without this
     project they belong to no tsconfig (tsconfig.app.json covers src/,
     tsconfig.node.json covers vite.config.ts), so `tsc -b` never type-checks
     them and an editor falls back to loose defaults. */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true
  },
  "include": ["e2e", "playwright.config.ts", "pwa-assets.config.ts"]
}
